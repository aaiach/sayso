# Copy to .env and adjust. .env is gitignored: per-instance settings live there, never in code.
# Secrets (the phone-pairing keys) are NOT here: the broker creates them at setup
# in the OS keyring (see BROKER_SECRET_BACKEND). Kerckhoffs: the code is public, only keys are secret.

# Chrome DevTools endpoint of the browser the agent drives (loopback only).
BROKER_CDP=http://127.0.0.1:9222
# That browser's --user-data-dir (used to find its window).
BROKER_PROFILE=~/.config/agent-chrome
# Python with the dependencies from pyproject.toml installed.
BROKER_PYTHON=python3
# Where the broker keeps its non-secret state (known sites).
BROKER_STATE_DIR=~/.local/share/credential-broker
# Where the broker keeps its own secrets: keyring (OS secret store, encrypted at rest; default)
# or file (0600 JSON in BROKER_STATE_DIR, not encrypted: only where no secret store exists).
BROKER_SECRET_BACKEND=keyring
# Keyring entry name (change it to run two instances side by side).
BROKER_KEYRING_SERVICE=sayso
# Your sayso relay (HTTPS), for phone approval. Empty = approve on this computer (local mode).
BROKER_RELAY_URL=
# Where you approve: auto (the paired phone when there is one, else this computer), phone, or local.
BROKER_APPROVER=auto
