# Copy to .env and adjust. .env is gitignored: per-instance settings live there, never in code.
# Secrets (PIN hash, authenticator secret, keys) are NOT here: the broker creates them in
# BROKER_STATE_DIR (mode 0600) at setup. Kerckhoffs: the code is public, only keys are secret.

# Chrome DevTools endpoint of the browser the agent drives (loopback only).
BROKER_CDP=http://127.0.0.1:9222
# That browser's --user-data-dir (used to find its window).
BROKER_PROFILE=~/.config/agent-chrome
# Python with playwright, mss and qrcode installed.
BROKER_PYTHON=python3
# Where the broker keeps its state (known sites, approval secrets).
BROKER_STATE_DIR=~/.local/share/credential-broker
# Terminal that shows the approval window (must run the given command in a new window).
BROKER_TERMINAL=gnome-terminal --title=sayso-approval --
