#!/bin/bash
# Open a terminal on the local desktop with a broker command pre-typed; the user presses Enter.
#   bin/broker-terminal google-card --site shop.example.com --card "My Visa" --last4 4242 --fill
# Output (approval prompts + masked JSON result) is logged to spike-out/last-run.log,
# except setup-* commands, which run unlogged.
# Secrets typed at hidden prompts are never echoed, so they never reach the log.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ -f "$HERE/.env" ] && { set -a; . "$HERE/.env"; set +a; }   # per-instance settings
PY="${BROKER_PYTHON:-python3}"
[ $# -gt 0 ] || { echo "usage: broker-terminal <cli args>" >&2; exit 2; }
CMD="$PY -m broker.cli $(printf '%q ' "$@")"
LOG="$HERE/spike-out/last-run.log"
mkdir -p "$HERE/spike-out"; rm -f "$LOG"
# setup-* shows the authenticator key / asks for a new PIN: run it unlogged.
case "$1" in setup-*) RUN='eval "$line"'; LOG="(not logged)";;
             *) RUN="script -q -e -c \"\$line\" $(printf '%q' "$LOG")";; esac
INNER=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/broker-run.XXXXXX")
cat > "$INNER" <<INNER
#!/bin/bash
cd $(printf '%q' "$HERE")
echo "Credential broker. Press Enter to run (Ctrl-C to abort). Nothing is ever submitted."
read -r -e -i $(printf '%q' "$CMD") -p "\$ " line && $RUN
rm -f -- "\$0"
exec bash
INNER
chmod 700 "$INNER"
export DISPLAY="${DISPLAY:-:0}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
setsid gnome-terminal --title="Credential broker" -- "$INNER" >/dev/null 2>&1 &
echo "terminal opened; log: $LOG"
